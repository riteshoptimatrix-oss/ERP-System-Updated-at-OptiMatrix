# ==============================================================================
# Opti Matrix ERP - Backend Environment Configuration (Example)
# ==============================================================================

# Application Environment (development, staging, production, test)
ENVIRONMENT=development

# Application Port and Host
HOST=0.0.0.0
PORT=8000

# Application Details
PROJECT_NAME="Opti Matrix ERP"
API_V1_PREFIX=/api/v1

# Structured Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true

# MongoDB Database Configuration
# In docker-compose: mongodb://mongodb:27017
# In local standalone: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=RG_erp
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000

# Security & CORS Settings (Comma-separated list of trusted frontend origins)
# Note: Wildcard '*' must never be used in production
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
