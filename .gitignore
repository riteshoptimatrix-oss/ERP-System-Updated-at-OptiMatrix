# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.development.local
.env.test.local
.env.production.local
Login Cred.txt
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
secrets/
credentials.json

