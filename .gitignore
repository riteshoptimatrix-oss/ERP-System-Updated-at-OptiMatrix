*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.iso
2022019010015 SY Project.zip

# ------------------------------------------------------------------------------
# 2. Database & Data Storage (Local MongoDB / SQLite / Backups)
# ------------------------------------------------------------------------------
**/data/db/
backend/data/
data/
*.wt
*.bson
mongod.lock
diagnostic.data/
WiredTiger*
_mdb_catalog.wt
sizeStorer.wt
storage.bson
*.sqlite
*.sqlite3
*.db
*.dump
*.sql

# ------------------------------------------------------------------------------
